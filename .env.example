# Copy to .env.local and fill in. Never commit real values.

# --- Core ---------------------------------------------------------------
# Local Docker Postgres during development; Neon pooled URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/weight_tracker"

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3010"
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# --- Epic 1: Google OAuth ------------------------------------------------
# Redirect URI: http://localhost:3010/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Epic 7: push notifications (VAPID) ----------------------------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:"

# --- Epic 7: email fallback ----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""
